# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=Multi-Agent AI Network Automation Platform
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# AI PROVIDER - NVIDIA
# =============================================================================
NVIDIA_API_KEY=replace_with_your_nvidia_api_key
NVIDIA_MODEL=replace_with_your_nvidia_model
CONVERSATION_TITLE_TIMEOUT_SECONDS=10

# Identity token signing secret
AUTH_JWT_SECRET=replace_with_a_long_random_auth_signing_secret
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30

# =============================================================================
# GNS3
# =============================================================================
GNS3_IP=127.0.0.1
GNS3_PORT=3080
GNS3_PROJECT_ID=replace_with_your_gns3_project_id
GNS3_REQUEST_TIMEOUT=10

# =============================================================================
# NETWORK CONNECTION
# =============================================================================
SSH_TIMEOUT=60
SSH_AUTH_TIMEOUT=30
SSH_DELAY_FACTOR=0.5
# `netmiko`: thực thi trực tiếp; `nornir`: Nornir điều phối và dùng Netmiko plugin.
NETWORK_BACKEND=netmiko
NORNIR_NUM_WORKERS=20

# =============================================================================
# DATABASE AND DOCKER
# =============================================================================
POSTGRES_DB=network_automation_db
POSTGRES_USER=network_automation_user
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_PORT=2204
DATABASE_URL=postgresql://network_automation_user:replace_with_a_strong_database_password@localhost:2204/network_automation_db

# Khóa này dùng để mã hóa/giải mã credential thiết bị, không được commit giá trị thật.
DEVICE_CREDENTIAL_ENCRYPTION_KEY=replace_with_a_long_random_encryption_key

PGADMIN_DEFAULT_EMAIL=admin@networkautomation.dev
PGADMIN_DEFAULT_PASSWORD=replace_with_a_strong_pgadmin_password
PGADMIN_PORT=5050

DOCKER_GNS3_IP=host.docker.internal
TZ=Asia/Ho_Chi_Minh
