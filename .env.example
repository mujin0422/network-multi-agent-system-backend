# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=Multi-Agent AI Network Automation Platform
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# Các giá trị này dùng khi khởi động Uvicorn từ command line hoặc script deploy.
API_HOST=0.0.0.0
API_PORT=8000

# =============================================================================
# AI PROVIDER - NVIDIA
# =============================================================================
NVIDIA_API_KEY=replace_with_your_nvidia_api_key
NVIDIA_MODEL=replace_with_your_nvidia_model

# =============================================================================
# GNS3
# =============================================================================
GNS3_IP=127.0.0.1
GNS3_PORT=3080
PROJECT_ID=replace_with_your_gns3_project_id

# =============================================================================
# NETWORK CONNECTION
# =============================================================================
SSH_TIMEOUT=60
SSH_AUTH_TIMEOUT=30
SSH_DELAY_FACTOR=0.5

# =============================================================================
# DATABASE AND DOCKER
# =============================================================================
POSTGRES_DB=network_automation_db
POSTGRES_USER=network_automation_user
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_PORT=2204
DATABASE_URL=postgresql://network_automation_user:replace_with_a_strong_database_password@localhost:5433/network_automation_db

# Chạy app trực tiếp mặc định dùng memory; Docker Compose tự override postgres.
INVENTORY_REPOSITORY_BACKEND=memory

# Khóa này dùng để mã hóa/giải mã credential thiết bị, không được commit giá trị thật.
DEVICE_CREDENTIAL_ENCRYPTION_KEY=replace_with_a_long_random_encryption_key

PGADMIN_DEFAULT_EMAIL=admin@networkautomation.dev
PGADMIN_DEFAULT_PASSWORD=replace_with_a_strong_pgadmin_password
PGADMIN_PORT=5050

DOCKER_GNS3_IP=host.docker.internal
TZ=Asia/Ho_Chi_Minh
